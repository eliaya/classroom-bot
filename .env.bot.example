# Discord Bot Secrets
# Paste your Bot Token from the Discord Developer Portal
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Set false for local compose when you want the container to stay up without connecting to Discord.
BOT_ENABLED=true

# Sync Configuration (interval in minutes, default is 10)
SYNC_INTERVAL_MINUTES=10

# Database URI (SQLite used inside the container volume)
DATABASE_URL="sqlite+aiosqlite:////app/data/classroom_sync.db"

# Google Credentials Paths
# These are mounted within the docker container at /app/credentials/
# client_secret.json must be a "Web application" OAuth client whose authorized
# redirect URIs include <web origin>/api/auth/google/callback.
GOOGLE_CLIENT_SECRET_FILE="/app/credentials/client_secret.json"
# Each user's own token is stored next to this file, under tokens/. The file
# itself is only the pre-multi-user token, kept for the first admin.
GOOGLE_TOKEN_FILE="/app/credentials/token.json"

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL="INFO"
# Emit structured JSON logs (with timestamp + job_id) instead of plain text.
LOG_JSON=false

# API / Web admin (FastAPI + shadcn-admin UI)
# Everyone signs in with Google. Comma-separated Google account emails that
# are always admins (re-applied on every sign-in); anyone else who signs in
# waits for an admin to assign them a role. Required.
ADMIN_EMAILS=""
# Lets the ADMIN_EMAILS addresses sign in with email + this password instead of
# Google, on their own page at /admin/login. Shared by all admins; use a long
# random value. Empty turns it off.
ADMIN_PASSWORD=""
API_HOST="0.0.0.0"
API_PORT=8095
CLASSROOM_SYNC_INTERVAL_MINUTES=30
# Every origin the web UI is opened from. Sign-in, Google's redirect back and
# all changes made from the browser are refused from any other origin.
API_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:8094"

# Classwork attachment content sync.
# Downloads Drive attachments (PDF/Excel) and exports Google Docs/Sheets during
# each course sync, storing files on disk with metadata in the DB. Requires the
# optional Drive scope — re-authorize in Settings to grant it. Without the
# scope, downloads are skipped and Classroom sync is unaffected.
ATTACHMENT_SYNC_ENABLED=true
ATTACHMENT_STORAGE_DIR="/app/data/attachments"
ATTACHMENT_MAX_BYTES=52428800
ATTACHMENT_DOWNLOAD_RETRIES=2

# Backup / restore. Archives stay on this box (nothing is uploaded anywhere);
# the directory must be inside the app_data volume to survive a rebuild.
# The schedule below only seeds the first run — after that the WebUI
# (Settings -> Backup) is the source of truth and persists in the database.
BACKUP_STORAGE_DIR="/app/data/backups"
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR=3
BACKUP_MINUTE=0

# Gmail Incoming Notification Placeholders (reserved for next phase)
# These values are currently accepted by configuration but not used by runtime code.
GMAIL_NOTIFICATIONS_ENABLED=false
GMAIL_POLL_INTERVAL_MINUTES=5
GMAIL_LABEL_FILTER="INBOX"
GMAIL_DISCORD_CHANNEL_ID=""
GOOGLE_GMAIL_TOKEN_FILE="/app/credentials/gmail_token.json"
HTTP_PORT=
